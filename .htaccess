# Safety net: any other path that differs only in letter case gets a 301
# to the correctly-cased file. Only fixes case, never spelling.
<IfModule mod_speling.c>
  CheckSpelling On
  CheckCaseOnly On
</IfModule>

# ---------------------------------------------------------------------------
# 3. Remove .html extension
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 (returns a real 404 status)
ErrorDocument 404 /404.html

# Never serve source, schema or docs — these belong in Supabase, not the web root
<FilesMatch "^\.|~$|\.(sql|ts|md|mjs|map|log|bak|old|orig|save|swp|tmp|env|ini|sh|yml|yaml|zip|tar|gz|rar|7z|psd|db|sqlite)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(backend|edge-functions)(/|$)

# MIME types (ensure server knows these formats)
AddType image/webp .webp
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/svg+xml .svg
AddType application/json .json
AddType application/javascript .js
AddType text/css .css
AddType font/woff2 .woff2
AddType font/woff .woff

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Fingerprinted / never-changing assets: let the phone keep them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the service worker itself must always be revalidated
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # supabase.js carries auth and message logic: a security fix here must reach
  # returning visitors on their next page view, not a month later. It loads after
  # window.onload, so revalidating it costs nothing on the critical path.
  <FilesMatch "^supabase\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # sitemap and robots must never be served stale to Googlebot
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compression — Brotli first where available, GZIP as fallback
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  # HSTS: after the first visit the browser goes straight to HTTPS, so the
  # http:// -> https:// redirect above never runs again (one round trip saved,
  # and no window for a downgrade attack). No includeSubDomains: subdomains
  # are not covered by this certificate setup.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"

  # Content-Security-Policy: bepaalt van welke domeinen deze site überhaupt iets
  # mag laden of waarheen hij mag praten. Injecteert iemand een script in een
  # veld of via een gekaapt CDN, dan weigert de browser het uit te voeren.
  # Kost nul milliseconden — het is één header, geen extra request.
  # Twijfel je na een wijziging? Zet tijdelijk deze regel aan in plaats van de
  # onderstaande, dan meldt de browser overtredingen zonder iets te blokkeren:
  #
  # Facebook staat er sinds 30-08-2026 bij. De Meta Pixel zat al in app.js en
  # staat ook in de cookieverklaring ("Only loaded after you choose Accept
  # all"), maar de drie CSP-bestanden noemden zijn hosts niet — hij werd dus
  # geblokkeerd en heeft nooit iets gemeten. Drie hosts, gemeten aan de inhoud
  # van fbevents.js zelf: connect.facebook.net (script-src, het bestand) en
  # www.facebook.com in img-src én connect-src (ENDPOINT "/tr/", het baken).
  # De Topics-registratie van Meta hoeft er niet bij: Permissions-Policy zet
  # browsing-topics uit. 'unsafe-eval' ook niet: het enige `new Function` in
  # fbevents.js is de globalThis-noodgreep en die zit in een try/catch.
  # Cloudflare Insights blijft bewust WEL geblokkeerd: dat script wordt door
  # Cloudflare zelf ingespoten en zou dus vóór de cookiekeuze draaien, wat de
  # eigen cookieverklaring tegenspreekt. Wil je die meting toch, zet hem dan
  # uit bij Cloudflare in plaats van hem hier toe te laten.
  #
  # Video tour (03-09-2026): property.html zet na een tik een iframe van
  # www.youtube-nocookie.com of player.vimeo.com neer (frame-src), en de
  # wizard en de objectpagina tonen de YouTube-thumbnail van i.ytimg.com
  # (img-src). Meer hosts niet: mkVideoInfo() in app.js herkent alleen deze
  # twee, dus een andere link komt nooit tot een iframe.
  # Header set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.modempay.com; frame-src 'self' https://*.modempay.com https://www.youtube-nocookie.com https://player.vimeo.com; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com https://api.mapbox.com https://*.supabase.co https://server.arcgisonline.com https://services.arcgisonline.com https://tile.openstreetmap.org https://www.facebook.com https://i.ytimg.com; font-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.maptiler.com https://api.mapbox.com https://api.modempay.com https://www.facebook.com https://cloudflareinsights.com; upgrade-insecure-requests"
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.modempay.com; frame-src 'self' https://*.modempay.com https://www.youtube-nocookie.com https://player.vimeo.com; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com https://api.mapbox.com https://*.supabase.co https://server.arcgisonline.com https://services.arcgisonline.com https://tile.openstreetmap.org https://www.facebook.com https://i.ytimg.com; font-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.maptiler.com https://api.mapbox.com https://api.modempay.com https://www.facebook.com https://cloudflareinsights.com; upgrade-insecure-requests"

  # Andere sites mogen onze afbeeldingen, fonts en scripts niet insluiten.
  Header set Cross-Origin-Resource-Policy "same-site"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Juridische signalen tegen tekst- en datamining (EU DSM art. 4) en tegen
  # hergebruik van tekst en foto's voor AI-training.
  Header set X-Robots-Tag "noai, noimageai"
  Header set tdm-reservation "1"
  Header set tdm-policy "https://mykunda.com/legal-terms.html"
</IfModule>
