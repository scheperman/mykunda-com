# MyKunda .htaccess

RewriteEngine On

# ===========================================================================
# 0. DIEFSTALBESCHERMING — staat bewust bovenaan: wie hier wordt geweigerd,
#    kost de server geen enkele regel verder werk. Kosten voor een gewone
#    bezoeker: nul (alleen tekstvergelijkingen op headers die er al zijn).
# ===========================================================================

# 0a. Geen mapoverzichten. Zonder dit toont Apache bij een map zonder index.html
#     de complete bestandslijst — de snelste manier om een site na te bouwen.
#     Geeft de host een 500? Dan mag Options hier niet en haal je deze regel weg.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
Options -MultiViews
ServerSignature Off

# 0b. Alleen de methodes die de site echt gebruikt.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$
RewriteRule ^ - [F,L]

# 0b-bis. EIGEN AUDIT. Start een crawl met ?mkaudit=... in de eerste URL en de
#     scraper- en harvesterblokkade hieronder wordt overgeslagen — alleen voor die
#     sessie, alleen voor wie de waarde kent. Vervang MKA-2026-Kunda-7X door een
#     eigen lange waarde en bewaar die buiten de site.
RewriteCond %{QUERY_STRING} (?:^|&)mkaudit=MKA-2026-Kunda-7X(?:&|$)
RewriteRule ^ - [E=MKAUDIT:1]

# 0c. Downloadprogramma's, mirrors en scrapers. Dit zijn de tools waarmee een
#     complete statische site in één commando wordt gekopieerd.
RewriteCond %{ENV:MKAUDIT} !=1
RewriteCond %{HTTP_USER_AGENT} (httrack|webzip|webcopier|webreaper|webstripper|teleport|sitesucker|offline\s?explorer|grab-a-site|website\s?extractor|copyrightcheck|zyborg|larbin|scrapy|python-requests|python-urllib|node-fetch|axios/|go-http-client|libwww-perl|okhttp|java/|wget|curl/|masscan|nikto|sqlmap|nmap) [NC]
RewriteRule ^ - [F,L]

# 0d. SEO-harvesters: ze crawlen de hele site om hem in commerciële databases te
#     zetten. Leveren geen bezoekers op en kosten alleen bandbreedte.
RewriteCond %{ENV:MKAUDIT} !=1
RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|blexbot|serpstatbot|dataforseobot|petalbot|barkrowler|seekport|magpie-crawler|megaindex|zoominfobot|sitebulb|screaming\s?frog) [NC]
RewriteRule ^ - [F,L]

# 0e. AI-crawlers die materiaal ophalen om modellen op te trainen. De crawlers
#     die bezoekers ópleveren (OAI-SearchBot, ChatGPT-User, PerplexityBot,
#     Googlebot, Bingbot) staan hier bewust NIET tussen.
RewriteCond %{HTTP_USER_AGENT} (gptbot|ccbot|claudebot|anthropic-ai|bytespider|amazonbot|meta-externalagent|facebookbot|diffbot|omgili|imagesift|img2dataset|youbot|timpibot|webzio|cohere-ai|scrapingbot) [NC]
RewriteRule ^ - [F,L]

# 0f. Lege user-agent: nooit een echte browser, altijd een script.
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule ^ - [F,L]

# 0g. Hotlinking: foto's en fonts alleen serveren aan mykunda.com zelf, aan
#     zoekmachines en aan de deelknoppen. Een lege referer blijft toegestaan —
#     dat is de directe intik en de "afbeelding openen in nieuw tabblad".
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?mykunda\.com [NC]
RewriteCond %{HTTP_REFERER} !(google|googleusercontent|bing|duckduckgo|yandex|ecosia|facebook|instagram|linkedin|pinterest|twitter|x\.com|t\.co|whatsapp|telegram|reddit)\. [NC]
RewriteRule \.(webp|jpe?g|png|gif|svg|avif|woff2?)$ - [F,NC,L]

# 0h. Mappen en bestanden die nooit publiek horen te zijn — het vangnet voor
#     als er per ongeluk iets meegeüpload wordt.
RedirectMatch 404 ^/(backend|edge-functions|archief|uploads|scraps|screenshots|node_modules|deploy|\.git|\.well-known/nonexistent)(/|$)
RedirectMatch 404 (?i)^/.*-(handleiding|controle|analyse|optimalisatie|herstelplan|verbeteringen|audit|prospectus)\.html$
RedirectMatch 404 (?i)^/(prompt-|werkplan|phase-|logo-|email-preview|photo-brief|voorstel-|instructie-|bouwplan).*\.html$
# Conceptversies van een pagina ("checkout v3.html") en de inerte Netlify/Vercel-
# configuratie horen niet in de webroot. Vangnet voor als er toch iets meegaat.
RedirectMatch 404 (?i)^/[a-z0-9-]+(\s|%20)v[0-9]+\.html$
RedirectMatch 404 ^/(_headers|_redirects|vercel\.json)$


# ---------------------------------------------------------------------------
# 1. Force HTTPS
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# 1b. Canonical host: strip www.
#     Without this, mykunda.com and www.mykunda.com are two sites with
#     identical content as far as Google is concerned.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ---------------------------------------------------------------------------
# 2. Legacy capitalised URLs -> lowercase (301)
#    Google discovered these from an older build; the real files are lowercase.
#    Query strings are preserved automatically.
# ---------------------------------------------------------------------------
RewriteRule ^Home\.html$            /                        [R=301,L]
RewriteRule ^Index\.html$           /                        [R=301,L]
RewriteRule ^About\.html$           /about.html              [R=301,L]
RewriteRule ^Search\.html$          /search.html             [R=301,L]
# Oude guide-URL's (guide.html?slug=…) naar de statische guide-pagina's
RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9-]+)(?:&|$)
RewriteRule ^guide\.html$ /guide-%1.html? [R=301,L]
# De kale guide.html is sinds de statische gidsen (15-08-2026) een lege shell die
# "Loading…" toont. Naar het overzicht, zodat er geen dunne pagina indexeerbaar blijft.
RewriteRule ^guide\.html$ /guides.html [R=301,L]

RewriteRule ^Guide\.html$           /guide.html              [R=301,L]
RewriteRule ^Guides\.html$          /guides.html             [R=301,L]
RewriteRule ^Property\.html$        /property.html           [R=301,L]
RewriteRule ^Messages\.html$        /messages.html           [R=301,L]
RewriteRule ^Buy\.html$             /buy.html                [R=301,L]
RewriteRule ^Rent\.html$            /rent.html               [R=301,L]
RewriteRule ^Sell\.html$            /sell.html               [R=301,L]
RewriteRule ^Safe\.html$            /safe.html               [R=301,L]
RewriteRule ^Agent\.html$           /agent.html              [R=301,L]
RewriteRule ^Contact\.html$         /contact.html            [R=301,L]
RewriteRule ^Faq\.html$             /faq.html                [R=301,L]
RewriteRule ^FAQ\.html$             /faq.html                [R=301,L]
RewriteRule ^Neighborhood\.html$    /kololi.html             [R=301,L]
RewriteRule ^neighborhood\.html$    /kololi.html             [R=301,L]


# Legal: the three documents are now real pages, so route the old
# ?doc= parameter URLs straight to them (query string dropped with the "?").
RewriteCond %{QUERY_STRING} (^|&)doc=terms(&|$)   [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-terms.html?       [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=privacy(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-privacy.html?     [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=cookies(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-cookies.html?     [R=301,L]
RewriteRule ^Legal\.html$           /legal.html              [R=301,L]

# home.html is the same page as the homepage -> collapse it into "/"
RewriteRule ^home\.html$            /                        [R=301,L]

# Hoofdletter-URL's van een oudere build. Google kent er een flink aantal
# (/Bijilo.html haalde 132 vertoningen, meer dan /bijilo.html) en die gaven tot
# 05-09-2026 een 404: het vangnet hieronder is mod_speling, en LiteSpeed heeft
# die module niet. build.mjs schrijft daarom zelf een regel per geuploade pagina.
# De RewriteCond eist een hoofdletter in het pad, zodat de goede kleine-letter-URL
# nooit naar zichzelf omleidt.
# BEGIN mk-case-redirects (104 pagina's, gegenereerd door build.mjs - niet met de hand wijzigen)
