# MyKunda .htaccess

RewriteEngine On

# ===========================================================================
# 0. DIEFSTALBESCHERMING — staat bewust bovenaan: wie hier wordt geweigerd,
#    kost de server geen enkele regel verder werk. Kosten voor een gewone
#    bezoeker: nul (alleen tekstvergelijkingen op headers die er al zijn).
# ===========================================================================

# 0a. Geen mapoverzichten. Zonder dit toont Apache bij een map zonder index.html
#     de complete bestandslijst — de snelste manier om een site na te bouwen.
#     Geeft de host een 500? Dan mag Options hier niet en haal je deze regel weg.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
Options -MultiViews
ServerSignature Off

# 0b. Alleen de methodes die de site echt gebruikt.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$
RewriteRule ^ - [F,L]

# 0c. Downloadprogramma's, mirrors en scrapers. Dit zijn de tools waarmee een
#     complete statische site in één commando wordt gekopieerd.
RewriteCond %{HTTP_USER_AGENT} (httrack|webzip|webcopier|webreaper|webstripper|teleport|sitesucker|offline\s?explorer|grab-a-site|website\s?extractor|copyrightcheck|zyborg|larbin|scrapy|python-requests|python-urllib|node-fetch|axios/|go-http-client|libwww-perl|okhttp|java/|wget|curl/|masscan|nikto|sqlmap|nmap) [NC]
RewriteRule ^ - [F,L]

# 0d. SEO-harvesters: ze crawlen de hele site om hem in commerciële databases te
#     zetten. Leveren geen bezoekers op en kosten alleen bandbreedte.
RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|blexbot|serpstatbot|dataforseobot|petalbot|barkrowler|seekport|magpie-crawler|megaindex|zoominfobot|sitebulb|screaming\s?frog) [NC]
RewriteRule ^ - [F,L]

# 0e. AI-crawlers die materiaal ophalen om modellen op te trainen. De crawlers
#     die bezoekers ópleveren (OAI-SearchBot, ChatGPT-User, PerplexityBot,
#     Googlebot, Bingbot) staan hier bewust NIET tussen.
RewriteCond %{HTTP_USER_AGENT} (gptbot|ccbot|claudebot|anthropic-ai|bytespider|amazonbot|meta-externalagent|facebookbot|diffbot|omgili|imagesift|img2dataset|youbot|timpibot|webzio|cohere-ai|scrapingbot) [NC]
RewriteRule ^ - [F,L]

# 0f. Lege user-agent: nooit een echte browser, altijd een script.
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule ^ - [F,L]

# 0g. Hotlinking: foto's en fonts alleen serveren aan mykunda.com zelf, aan
#     zoekmachines en aan de deelknoppen. Een lege referer blijft toegestaan —
#     dat is de directe intik en de "afbeelding openen in nieuw tabblad".
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?mykunda\.com [NC]
RewriteCond %{HTTP_REFERER} !(google|googleusercontent|bing|duckduckgo|yandex|ecosia|facebook|instagram|linkedin|pinterest|twitter|x\.com|t\.co|whatsapp|telegram|reddit)\. [NC]
RewriteRule \.(webp|jpe?g|png|gif|svg|avif|woff2?)$ - [F,NC,L]

# 0h. Mappen en bestanden die nooit publiek horen te zijn — het vangnet voor
#     als er per ongeluk iets meegeüpload wordt.
RedirectMatch 404 ^/(backend|edge-functions|archief|uploads|scraps|screenshots|node_modules|deploy|\.git|\.well-known/nonexistent)(/|$)
RedirectMatch 404 (?i)^/.*-(handleiding|controle|analyse|optimalisatie|herstelplan|verbeteringen|audit|prospectus)\.html$
RedirectMatch 404 (?i)^/(prompt-|werkplan|phase-|logo-|email-preview|photo-brief).*\.html$


# ---------------------------------------------------------------------------
# 1. Force HTTPS
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# 1b. Canonical host: strip www.
#     Without this, mykunda.com and www.mykunda.com are two sites with
#     identical content as far as Google is concerned.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ---------------------------------------------------------------------------
# 2. Legacy capitalised URLs -> lowercase (301)
#    Google discovered these from an older build; the real files are lowercase.
#    Query strings are preserved automatically.
# ---------------------------------------------------------------------------
RewriteRule ^Home\.html$            /                        [R=301,L]
RewriteRule ^Index\.html$           /                        [R=301,L]
RewriteRule ^About\.html$           /about.html              [R=301,L]
RewriteRule ^Search\.html$          /search.html             [R=301,L]
# Oude guide-URL's (guide.html?slug=…) naar de statische guide-pagina's
RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9-]+)(?:&|$)
RewriteRule ^guide\.html$ /guide-%1.html? [R=301,L]

RewriteRule ^Guide\.html$           /guide.html              [R=301,L]
RewriteRule ^Guides\.html$          /guides.html             [R=301,L]
RewriteRule ^Property\.html$        /property.html           [R=301,L]
RewriteRule ^Messages\.html$        /messages.html           [R=301,L]
RewriteRule ^Buy\.html$             /buy.html                [R=301,L]
RewriteRule ^Rent\.html$            /rent.html               [R=301,L]
RewriteRule ^Sell\.html$            /sell.html               [R=301,L]
RewriteRule ^Safe\.html$            /safe.html               [R=301,L]
RewriteRule ^Agent\.html$           /agent.html              [R=301,L]
RewriteRule ^Contact\.html$         /contact.html            [R=301,L]
RewriteRule ^Faq\.html$             /faq.html                [R=301,L]
RewriteRule ^FAQ\.html$             /faq.html                [R=301,L]
RewriteRule ^Neighborhood\.html$    /kololi.html             [R=301,L]
RewriteRule ^neighborhood\.html$    /kololi.html             [R=301,L]

# Legal: the three documents are now real pages, so route the old
# ?doc= parameter URLs straight to them (query string dropped with the "?").
RewriteCond %{QUERY_STRING} (^|&)doc=terms(&|$)   [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-terms.html?       [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=privacy(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-privacy.html?     [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=cookies(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-cookies.html?     [R=301,L]
RewriteRule ^Legal\.html$           /legal.html              [R=301,L]

# home.html is the same page as the homepage -> collapse it into "/"
RewriteRule ^home\.html$            /                        [R=301,L]

# Safety net: any other path that differs only in letter case gets a 301
# to the correctly-cased file. Only fixes case, never spelling.
<IfModule mod_speling.c>
  CheckSpelling On
  CheckCaseOnly On
</IfModule>

# ---------------------------------------------------------------------------
# 3. Remove .html extension
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 (returns a real 404 status)
ErrorDocument 404 /404.html

# Never serve source, schema or docs — these belong in Supabase, not the web root
<FilesMatch "^\.|~$|\.(sql|ts|md|mjs|map|log|bak|old|orig|save|swp|tmp|env|ini|sh|yml|yaml|zip|tar|gz|rar|7z|psd|db|sqlite)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(backend|edge-functions)(/|$)

# MIME types (ensure server knows these formats)
AddType image/webp .webp
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/svg+xml .svg
AddType application/json .json
AddType application/javascript .js
AddType text/css .css
AddType font/woff2 .woff2
AddType font/woff .woff

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Fingerprinted / never-changing assets: let the phone keep them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the service worker itself must always be revalidated
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # supabase.js carries auth and message logic: a security fix here must reach
  # returning visitors on their next page view, not a month later. It loads after
  # window.onload, so revalidating it costs nothing on the critical path.
  <FilesMatch "^supabase\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # sitemap and robots must never be served stale to Googlebot
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compression — Brotli first where available, GZIP as fallback
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  # HSTS: after the first visit the browser goes straight to HTTPS, so the
  # http:// -> https:// redirect above never runs again (one round trip saved,
  # and no window for a downgrade attack). No includeSubDomains: subdomains
  # are not covered by this certificate setup.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"

  # Content-Security-Policy: bepaalt van welke domeinen deze site überhaupt iets
  # mag laden of waarheen hij mag praten. Injecteert iemand een script in een
  # veld of via een gekaapt CDN, dan weigert de browser het uit te voeren.
  # Kost nul milliseconden — het is één header, geen extra request.
  # Twijfel je na een wijziging? Zet tijdelijk deze regel aan in plaats van de
  # onderstaande, dan meldt de browser overtredingen zonder iets te blokkeren:
  # Header set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.modempay.com; frame-src 'self' https://*.modempay.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com https://*.supabase.co; font-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.maptiler.com https://api.frankfurter.app https://api.modempay.com; upgrade-insecure-requests"
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.modempay.com; frame-src 'self' https://*.modempay.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com https://*.supabase.co; font-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.maptiler.com https://api.frankfurter.app https://api.modempay.com; upgrade-insecure-requests"

  # Andere sites mogen onze afbeeldingen, fonts en scripts niet insluiten.
  Header set Cross-Origin-Resource-Policy "same-site"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Juridische signalen tegen tekst- en datamining (EU DSM art. 4) en tegen
  # hergebruik van tekst en foto's voor AI-training.
  Header set X-Robots-Tag "noai, noimageai"
  Header set tdm-reservation "1"
  Header set tdm-policy "https://mykunda.com/legal-terms.html"
</IfModule>
