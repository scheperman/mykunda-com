# MyKunda .htaccess

RewriteEngine On

# ---------------------------------------------------------------------------
# 1. Force HTTPS
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# 1b. Canonical host: strip www.
#     Without this, mykunda.com and www.mykunda.com are two sites with
#     identical content as far as Google is concerned.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ---------------------------------------------------------------------------
# 2. Legacy capitalised URLs -> lowercase (301)
#    Google discovered these from an older build; the real files are lowercase.
#    Query strings are preserved automatically.
# ---------------------------------------------------------------------------
RewriteRule ^Home\.html$            /                        [R=301,L]
RewriteRule ^Index\.html$           /                        [R=301,L]
RewriteRule ^About\.html$           /about.html              [R=301,L]
RewriteRule ^Search\.html$          /search.html             [R=301,L]
RewriteRule ^Guide\.html$           /guide.html              [R=301,L]
RewriteRule ^Guides\.html$          /guides.html             [R=301,L]
RewriteRule ^Property\.html$        /property.html           [R=301,L]
RewriteRule ^Messages\.html$        /messages.html           [R=301,L]
RewriteRule ^Buy\.html$             /buy.html                [R=301,L]
RewriteRule ^Rent\.html$            /rent.html               [R=301,L]
RewriteRule ^Sell\.html$            /sell.html               [R=301,L]
RewriteRule ^Safe\.html$            /safe.html               [R=301,L]
RewriteRule ^Agent\.html$           /agent.html              [R=301,L]
RewriteRule ^Contact\.html$         /contact.html            [R=301,L]
RewriteRule ^Faq\.html$             /faq.html                [R=301,L]
RewriteRule ^FAQ\.html$             /faq.html                [R=301,L]
RewriteRule ^Neighborhood\.html$    /kololi.html             [R=301,L]
RewriteRule ^neighborhood\.html$    /kololi.html             [R=301,L]

# Legal: the three documents are now real pages, so route the old
# ?doc= parameter URLs straight to them (query string dropped with the "?").
RewriteCond %{QUERY_STRING} (^|&)doc=terms(&|$)   [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-terms.html?       [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=privacy(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-privacy.html?     [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)doc=cookies(&|$) [NC]
RewriteRule ^(Legal|legal)\.html$   /legal-cookies.html?     [R=301,L]
RewriteRule ^Legal\.html$           /legal.html              [R=301,L]

# home.html is the same page as the homepage -> collapse it into "/"
RewriteRule ^home\.html$            /                        [R=301,L]

# Safety net: any other path that differs only in letter case gets a 301
# to the correctly-cased file. Only fixes case, never spelling.
<IfModule mod_speling.c>
  CheckSpelling On
  CheckCaseOnly On
</IfModule>

# ---------------------------------------------------------------------------
# 3. Remove .html extension
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 (returns a real 404 status)
ErrorDocument 404 /404.html

# Never serve source, schema or docs — these belong in Supabase, not the web root
<FilesMatch "\.(sql|ts|md|log|bak|env)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(backend|edge-functions)(/|$)

# MIME types (ensure server knows these formats)
AddType image/webp .webp
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/svg+xml .svg
AddType application/json .json
AddType application/javascript .js
AddType text/css .css
AddType font/woff2 .woff2
AddType font/woff .woff

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Fingerprinted / never-changing assets: let the phone keep them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the service worker itself must always be revalidated
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # supabase.js carries auth and message logic: a security fix here must reach
  # returning visitors on their next page view, not a month later. It loads after
  # window.onload, so revalidating it costs nothing on the critical path.
  <FilesMatch "^supabase\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # sitemap and robots must never be served stale to Googlebot
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compression — Brotli first where available, GZIP as fallback
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  # HSTS: after the first visit the browser goes straight to HTTPS, so the
  # http:// -> https:// redirect above never runs again (one round trip saved,
  # and no window for a downgrade attack). No includeSubDomains: subdomains
  # are not covered by this certificate setup.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
